rules_version = '2';

// Firestore Security Rules — Firestore client-SDK migration (Variant B), Phase 1.
//
// Invariant: a signed-in user may touch ONLY the documents they own.
//   - Most collections own via a `userId` field.
//   - studyNoteShareLinks owns via `ownerId`.
//   - users (settings) is owned by DOC ID == the caller's uid.
//   - Telemetry collections have NO user owner -> client access denied (default-deny).
//
// These rules are deployed in Phase 1 but DORMANT until a collection is moved to the
// client SDK (Phase 2+): today all data flows through the server's Admin SDK, which
// bypasses rules. Public note-sharing reads stay server-only (Admin), not here.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // The EXISTING doc's owner field equals the caller.
    function ownsExisting(field) {
      return signedIn() && resource.data[field] == request.auth.uid;
    }
    // The INCOMING doc's owner field equals the caller (and can't be reassigned away).
    function ownsIncoming(field) {
      return signedIn() && request.resource.data[field] == request.auth.uid;
    }

    // ---- Revision protocol (PREPARED, NOT ARMED — see the checklist) ----
    //
    // The freshness mechanism refuses a save built from an older revision by
    // comparing `rev.<aggregate>` inside a transaction. That guarantee holds only
    // while EVERY writer maintains the counter. Today's clients do; an OLD build
    // still installed as a PWA on someone's phone does not — it changes content
    // and leaves the number alone, which makes the counter LIE, and a later stale
    // save is then handed permission to overwrite.
    //
    // The rule below closes that hole at the database. It is deliberately left
    // COMMENTED OUT, because arming it is a rollout decision, not a code change:
    // the moment it ships, every client that does not bump the counter starts
    // getting permission-denied — including old PWA installs that have not picked
    // up the new bundle yet.
    //
    // ACTIVATION CHECKLIST (owner's call):
    //   1. The new build has been live long enough that stale PWA installs have
    //      refreshed (the service worker updates on next visit).
    //   2. Admin SDK writers are audited: they BYPASS rules entirely, so any
    //      server path that changes content must advance the counter on its own
    //      (`updateSermonData` takes an aggregate name; check new writers too).
    //   3. Deploy the rules, then watch for permission-denied in the logs.
    //
    // function advancesRevision(aggregate) {
    //   return !(aggregate in request.resource.data.get('rev', {}))
    //     || request.resource.data.rev[aggregate] > resource.data.get('rev', {}).get(aggregate, 0);
    // }

    // ---- Collections owned via a `userId` field ----
    match /sermons/{id} {
      allow read, delete: if ownsExisting('userId');
      allow create:       if ownsIncoming('userId');
      allow update:       if ownsExisting('userId') && ownsIncoming('userId');
    }
    match /studyNotes/{id} {
      allow read, delete: if ownsExisting('userId');
      allow create:       if ownsIncoming('userId');
      allow update:       if ownsExisting('userId') && ownsIncoming('userId');
    }
    match /studyNoteBranchStates/{id} {
      allow read, delete: if ownsExisting('userId');
      allow create:       if ownsIncoming('userId');
      allow update:       if ownsExisting('userId') && ownsIncoming('userId');
    }
    match /series/{id} {
      allow read, delete: if ownsExisting('userId');
      allow create:       if ownsIncoming('userId');
      allow update:       if ownsExisting('userId') && ownsIncoming('userId');
    }
    match /groups/{id} {
      allow read, delete: if ownsExisting('userId');
      allow create:       if ownsIncoming('userId');
      allow update:       if ownsExisting('userId') && ownsIncoming('userId');
    }
    match /prayerRequests/{id} {
      allow read, delete: if ownsExisting('userId');
      allow create:       if ownsIncoming('userId');
      allow update:       if ownsExisting('userId') && ownsIncoming('userId');
    }
    match /prayerCategories/{id} {
      allow read, delete: if ownsExisting('userId');
      allow create:       if ownsIncoming('userId');
      allow update:       if ownsExisting('userId') && ownsIncoming('userId');
    }
    match /tags/{id} {
      allow read, delete: if ownsExisting('userId');
      allow create:       if ownsIncoming('userId');
      allow update:       if ownsExisting('userId') && ownsIncoming('userId');
    }
    match /planTemplates/{id} {
      allow read, delete: if ownsExisting('userId');
      allow create:       if ownsIncoming('userId');
      allow update:       if ownsExisting('userId') && ownsIncoming('userId');
    }
    match /feedback/{id} {
      allow read, delete: if ownsExisting('userId');
      allow create:       if ownsIncoming('userId');
      allow update:       if ownsExisting('userId') && ownsIncoming('userId');
    }

    // ---- Share links: owned via `ownerId` (public READ is server-only via Admin, not here) ----
    match /studyNoteShareLinks/{id} {
      allow read, delete: if ownsExisting('ownerId');
      allow create:       if ownsIncoming('ownerId');
      allow update:       if ownsExisting('ownerId') && ownsIncoming('ownerId');
    }

    // ---- User settings: owned by DOC ID == uid ----
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['paidTier', 'promotion', 'usage', 'role', 'referredBy']);
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['paidTier', 'promotion', 'usage', 'role', 'referredBy']);
    }

    // ---- Server-managed AI model defaults (Admin SDK only) ----
    match /config/aiModelDefaults {
      allow read, write: if false;
    }

    // ---- Server-managed referral reward records (Admin SDK only) ----
    match /referralEvents/{id} {
      allow read, write: if false;
    }

    // ---- Server-only telemetry (no user owner): ai_prompt_telemetry, api_performance_telemetry ----
    // Not matched above => denied by the default-deny rule below. Admin SDK still writes them server-side.

    // ---- Default deny: anything not explicitly allowed ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
